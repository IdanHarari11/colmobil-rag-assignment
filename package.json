{
  "name": "colmobil-service-rag",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "prepare:colmobil": "python scripts/prepare_colmobil.py",
    "index:colmobil": "node --import tsx scripts/index-colmobil.ts",
    "eval:colmobil": "node --import tsx scripts/eval-colmobil.ts",
    "test:colmobil": "vitest run src/support",
    "test:core": "vitest run src/rag/bm25.test.ts src/rag/hybrid-retrieve.test.ts src/rag/history.test.ts src/rag/rewrite-query.test.ts",
    "test:gates": "pnpm typecheck && pnpm lint && pnpm test:colmobil && pnpm test:core && pnpm build",
    "eval:answers:colmobil": "node --import tsx scripts/eval-colmobil-answers.ts",
    "eval:retrieval:comparison": "node --import tsx scripts/eval-colmobil-retrieval-comparison.ts",
    "eval:conversations:colmobil": "node --import tsx scripts/eval-colmobil-conversations.ts",
    "eval:voice:colmobil": "node --import tsx scripts/eval-colmobil-voice.ts"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.3.30",
    "@assistant-ui/react": "^0.15.30",
    "@assistant-ui/react-markdown": "^0.14.23",
    "@base-ui/react": "^1.9.0",
    "assistant-stream": "^0.3.53",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.2",
    "node-html-parser": "^9.0.5",
    "openai": "^7.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.22.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "unified": "^11.0.5",
    "unpdf": "^1.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^65.0.0",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@12.11.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
